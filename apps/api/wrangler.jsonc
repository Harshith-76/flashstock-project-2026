{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flashstock-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-16",
	"vars": {
		"ENVIRONMENT": "production"
	},
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api", "/api/*"]
	},
	"triggers": { "crons": ["*/1 * * * *"] },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "flashstock-db",
			"database_id": "90b77993-51a2-4b83-834e-4966c5c06e4d"
		}
	]
}
